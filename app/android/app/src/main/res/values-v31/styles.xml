<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) shows its own mandatory SplashScreen API splash
         BEFORE this drawable/launch_background.xml one -- without this override
         it auto-derives that splash from the launcher icon on a white circle,
         which is the white flash this file exists to remove. Setting the icon
         to fully transparent leaves a flat splash_background field only; the
         real "renly" wordmark + tagline still shows via the Flutter-side
         SplashScreen widget a moment later. -->
    <style name="LaunchTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
